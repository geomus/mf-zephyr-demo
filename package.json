{
  "name": "mf-zephyr-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.13",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive build",
    "zephyr:remote": "pnpm --filter remote zephyr",
    "zephyr:host": "pnpm --filter host zephyr",
    "zephyr:all": "pnpm zephyr:remote && pnpm zephyr:host",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "biome check . && pnpm --filter remote build && pnpm typecheck && pnpm test && pnpm build",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
